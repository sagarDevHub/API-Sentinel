# Server
NODE_ENV=development
PORT=5000

# MongoDB (Local or Atlas)
MONGO_URI=mongodb://localhost:27017/api_monitoring
MONGO_DB_NAME=api_monitoring

# PostgreSQL (Set DATABASE_URL for hosted DB like Neon + PG_SSL=true, or use PG_* for local Docker)
DATABASE_URL=
PG_SSL=false
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=api_monitoring
PG_USER=postgres
PG_PASSWORD=postgres

# RabbitMQ (Local Docker or CloudAMQP amqps://...)
RABBITMQ_URL=
RABBITMQ_QUEUE=api_hits
RABBITMQ_PUBLISHER_CONFIRMS=false
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=1000

# Redis (Local Docker or Upstash rediss://...)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=api_sentinel:
REDIS_TTL_SECONDS=3600

# JWT & Rate Limiting
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
RATE_LIMIT_WINDOWS_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Password Policy (Optional — defaults shown)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# API Keys (optional)
API_KEY_EXPIRY_DAYS=365